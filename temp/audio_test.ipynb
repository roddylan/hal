   "source": [
    "import pyttsx3\n",
    "\n",
    "engine = pyttsx3.init()\n",
    "for v in engine.getProperty('voices'):\n",
    "    print(v.id)\n",
    "\n",
    "# engine.setProperty('voice', 'com.apple.speech.synthesis.voice.samantha')\n",
    "engine.setProperty('rate', 175)\n",
    "engine.say(\"Hello there, this is Samantha speaking.\")\n",
    "engine.runAndWait()\n"
   ]
